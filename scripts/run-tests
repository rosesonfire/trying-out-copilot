#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--build" ]; }; then
  echo "Usage: $0 [--build]" >&2
  exit 2
fi

if [ "$#" -eq 1 ]; then
  image_name=$(docker compose config --images test)
  docker compose rm --stop --force test

  image_ids=$(docker image ls --quiet --filter "reference=$image_name")
  for image_id in $image_ids; do
    docker image rm "$image_id"
  done

  docker compose build --no-cache test
fi

exec docker compose up test
